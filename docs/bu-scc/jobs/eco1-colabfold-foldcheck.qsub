#!/bin/bash -l
#$ -N eco1_colabfold_foldcheck
#$ -P dunlop
#$ -l h_rt=04:00:00
#$ -pe omp 4
#$ -l mem_per_core=8G
#$ -l gpus=1
#$ -j y
#$ -o /project/dunlop/esouth/foldcheck/eco1_rt/sge_logs/$JOB_NAME.$JOB_ID.out

set -euo pipefail

# Eco1 fold-check runtime lane.
# This job consumes a materialized foldcheck_request manifest and runs the
# external ColabFold CLI. It does not normalize results into dnadesign contracts.

module purge

export OMP_NUM_THREADS="${NSLOTS:-4}"

if [[ -n "${CUDA_MODULE:-}" ]]; then
  module load "$CUDA_MODULE"
fi

if [[ -n "${GCC_MODULE:-}" ]]; then
  module load "$GCC_MODULE"
fi

repo_root="${DNADESIGN_REPO:-$PWD}"
cd "$repo_root"

request_manifest="${FOLDCHECK_REQUEST_MANIFEST:-src/dnadesign/studies/units/eco1_rt_repack/workspaces/eco1_rt_conservative_v1/outputs/thread/foldcheck_request/foldcheck_request_manifest.yaml}"
sequence_limit="${FOLDCHECK_SEQUENCE_LIMIT:-6}"
run_root="${FOLDCHECK_RUN_ROOT:-/project/dunlop/esouth/foldcheck/eco1_rt/${JOB_NAME}.${JOB_ID:-manual}}"
input_fasta="$run_root/input_sequences.fasta"
output_dir="$run_root/colabfold_outputs"
run_manifest="$run_root/colabfold_run_manifest.yaml"

if [[ ! -f "$request_manifest" ]]; then
  echo "FOLDCHECK_REQUEST_MANIFEST does not exist: $request_manifest" >&2
  exit 2
fi

mkdir -p "$run_root" "$output_dir"

if [[ -n "$(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit)" && "${FOLDCHECK_ALLOW_EXISTING_OUTPUT:-0}" != "1" ]]; then
  echo "Refusing to write into non-empty ColabFold output directory: $output_dir" >&2
  exit 2
fi

uv run python - "$request_manifest" "$sequence_limit" "$input_fasta" "$run_manifest" "$output_dir" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml

manifest_path = Path(sys.argv[1])
limit_text = sys.argv[2]
input_fasta = Path(sys.argv[3])
run_manifest = Path(sys.argv[4])
output_dir = Path(sys.argv[5])

manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
source_fasta = Path(manifest["input_fasta_path"])
if not source_fasta.is_absolute():
    source_fasta = (manifest_path.parent / source_fasta).resolve()
if not source_fasta.exists():
    source_fasta = Path(manifest["input_fasta_path"])
if not source_fasta.exists():
    raise SystemExit(f"foldcheck input FASTA not found: {manifest['input_fasta_path']}")

records: list[tuple[str, str]] = []
header: str | None = None
sequence_parts: list[str] = []
for line in source_fasta.read_text(encoding="utf-8").splitlines():
    if line.startswith(">"):
        if header is not None:
            records.append((header, "".join(sequence_parts)))
        header = line[1:].strip()
        sequence_parts = []
    else:
        sequence_parts.append(line.strip())
if header is not None:
    records.append((header, "".join(sequence_parts)))

if not records:
    raise SystemExit(f"foldcheck input FASTA has no records: {source_fasta}")

if limit_text.lower() == "all":
    selected_records = records
else:
    limit = int(limit_text)
    if limit < 1:
        raise SystemExit("FOLDCHECK_SEQUENCE_LIMIT must be a positive integer or 'all'")
    selected_records = records[:limit]

input_fasta.parent.mkdir(parents=True, exist_ok=True)
input_fasta.write_text(
    "".join(f">{name}\n{sequence}\n" for name, sequence in selected_records),
    encoding="utf-8",
)

run_payload = {
    "schema_id": "eco1_rt.colabfold_scc_run_manifest",
    "schema_version": 1,
    "source_request_manifest": str(manifest_path),
    "source_request_hash": manifest["request_hash"],
    "source_sequence_count": manifest["sequence_count"],
    "selected_sequence_count": len(selected_records),
    "selected_sequence_ids": [name for name, _ in selected_records],
    "input_fasta": str(input_fasta),
    "output_dir": str(output_dir),
    "execution_status": "submitted_to_external_colabfold_cli",
}
run_manifest.write_text(yaml.safe_dump(run_payload, sort_keys=False), encoding="utf-8")
print(f"wrote {len(selected_records)} fold-check sequences to {input_fasta}")
print(f"wrote run manifest to {run_manifest}")
PY

if [[ -n "${COLABFOLD_ENV_ACTIVATE:-}" ]]; then
  # shellcheck disable=SC1090
  source "$COLABFOLD_ENV_ACTIVATE"
fi

colabfold_batch_bin="${COLABFOLD_BATCH:-colabfold_batch}"
if [[ -n "${COLABFOLD_LD_LIBRARY_PATH:-}" ]]; then
  export LD_LIBRARY_PATH="${COLABFOLD_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH:-}"
fi
if [[ "$colabfold_batch_bin" = /* && -x "$colabfold_batch_bin" ]]; then
  colabfold_env_root="$(dirname "$(dirname "$colabfold_batch_bin")")"
  if [[ -d "$colabfold_env_root/lib" ]]; then
    export LD_LIBRARY_PATH="$colabfold_env_root/lib:${LD_LIBRARY_PATH:-}"
  fi
fi
if ! command -v "$colabfold_batch_bin" >/dev/null 2>&1; then
  echo "colabfold_batch command not found. Set COLABFOLD_BATCH, COLABFOLD_ENV_ACTIVATE, or COLABFOLD_LD_LIBRARY_PATH." >&2
  exit 2
fi

colabfold_args=()
if [[ -n "${COLABFOLD_EXTRA_ARGS:-}" ]]; then
  # shellcheck disable=SC2206
  colabfold_args=($COLABFOLD_EXTRA_ARGS)
fi

echo "Running $colabfold_batch_bin ${colabfold_args[*]} $input_fasta $output_dir"
"$colabfold_batch_bin" "${colabfold_args[@]}" "$input_fasta" "$output_dir"
