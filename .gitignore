# =============================================================================
# dnadesign — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# OS cruft
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux/Unix temp + swap
*.~lock.*
*~
*.swp
*.swo

# -----------------------------------------------------------------------------
# Editor / IDE cruft
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Misc editor output
out/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Python build & tooling
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd

# Packaging / builds
*.egg
*.egg-info/
.eggs/
build/
dist/
*.whl

# Virtual envs
.venv/
env/
venv/
.pixi/

# Test/analysis caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.cache/matplotlib/
.nox/
.coverage
.coverage.*
htmlcov/
/core-junit.xml
/ci-capabilities.json

# -----------------------------------------------------------------------------
# Node / JS (if present)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Logs, temp files
# -----------------------------------------------------------------------------
*.log
*.out
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
temp.md
tmp/

# Local operator configuration (copy the tracked example before use)
src/dnadesign/seqledger/remotes.yaml

# -----------------------------------------------------------------------------
# Archives
# -----------------------------------------------------------------------------
/archived/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -----------------------------------------------------------------------------
# Large/binary data artifacts (keep out of git)
# -----------------------------------------------------------------------------
*.parquet
*.parq
*.pq
*.feather
*.joblib
*.pkl
*.pt
!src/dnadesign/baserender/docs/examples/data/*.parquet

# -----------------------------------------------------------------------------
# Images: ignore by default; allow curated exceptions
# -----------------------------------------------------------------------------
*.png
!assets/dnadesign-banner.png
*.jpg
*.jpeg
*.gif

# allow curated PNGs
!src/dnadesign/nmf/images/
!src/dnadesign/nmf/images/*.png
!src/dnadesign/libshuffle/images/*.png
!images/*.png
# allow Cruncher docs media
!src/dnadesign/cruncher/docs/**/*.png
!src/dnadesign/cruncher/docs/**/*.jpg
!src/dnadesign/cruncher/docs/**/*.jpeg
!src/dnadesign/cruncher/docs/**/*.gif
!src/dnadesign/cruncher/images/*.png

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Cruncher: local cache + run outputs + experiment artifacts (keep demos/templates)
.cruncher/
**/.cruncher/
src/dnadesign/cruncher/.cruncher/
src/dnadesign/cruncher/results/
src/dnadesign/cruncher/experiments/
src/dnadesign/cruncher/old_results/
src/dnadesign/cruncher/workspaces/**/.cruncher/
src/dnadesign/cruncher/**/runs/
src/dnadesign/cruncher/workspaces/**/runs/
src/dnadesign/cruncher/workspaces/**/campaign.*.yaml
src/dnadesign/cruncher/workspaces/**/campaign_*.yaml
src/dnadesign/cruncher/workspaces/**/*.campaign_manifest.json
src/dnadesign/cruncher/**/run_manifest.json
src/dnadesign/cruncher/**/run_status.json
src/dnadesign/cruncher/**/config_used.yaml
src/dnadesign/cruncher/**/sequences.csv
src/dnadesign/cruncher/**/sequences.parquet
!src/dnadesign/cruncher/src/utils/elites.py
!src/dnadesign/cruncher/src/analysis/elites.py
src/dnadesign/cruncher/**/trace.nc
src/dnadesign/cruncher/**/gathered_per_pwm_*.csv
src/dnadesign/cruncher/workspaces/archived/
projects/**/projects/
src/dnadesign/cruncher/projects/**/projects/

# Internal archives/prototypes
src/dnadesign/archived/
src/dnadesign/prototypes/
src/dnadesign/seqledger/archived/
src/dnadesign/seqledger/datasets/usr_regulondb_native_promoters/

# OPAL campaigns: keep configs tracked, ignore artifacts/data.
src/dnadesign/opal/campaigns/**
!src/dnadesign/opal/campaigns/**/
!src/dnadesign/opal/campaigns/**/campaign.yaml
!src/dnadesign/opal/campaigns/**/plots.yaml
!src/dnadesign/opal/campaigns/**/README.md
!src/dnadesign/opal/campaigns/.gitignore
src/dnadesign/opal/campaigns/**/notebooks/
src/dnadesign/opal/campaigns/**/notebooks/**
src/dnadesign/opal/campaigns/**/inputs/
src/dnadesign/opal/campaigns/**/records.parquet
!src/dnadesign/opal/campaigns/_fixtures/**
src/dnadesign/opal/campaigns/**/inputs/**/.DS_Store

# Live study state belongs in an external study repository. Ignore any local
# residue from checkouts created before that boundary was established.
docs/studies/
src/dnadesign/studies/

# OPAL per-run products anywhere
**/outputs/
# Cruncher demo fixtures: keep packaged YIU demo bundle outputs, not full run trees.
!src/dnadesign/cruncher/workspaces/demo_yiu_payload/outputs/
src/dnadesign/cruncher/workspaces/demo_yiu_payload/outputs/**
!src/dnadesign/cruncher/workspaces/demo_yiu_payload/outputs/*/
!src/dnadesign/cruncher/workspaces/demo_yiu_payload/outputs/*/**
!src/dnadesign/cruncher/workspaces/demo_yiu_payload/outputs/*__payload_views.pdf
!src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/
src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/**
!src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/plots/
src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/plots/**
!src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/plots/yiu__*/
!src/dnadesign/cruncher/workspaces/demo_monotypic_*/outputs/plots/yiu__*/**
# BaseRender code package named "outputs" (not a run artifact)
!src/dnadesign/baserender/src/outputs/
!src/dnadesign/baserender/src/outputs/**
src/dnadesign/baserender/src/outputs/**/__pycache__/
src/dnadesign/baserender/src/outputs/**/*.pyc
!src/dnadesign/baserender/assets/overlays/*.png
# BaseRender workspaces: ignore everything by default, allow README
src/dnadesign/baserender/workspaces/**
!src/dnadesign/baserender/workspaces/README.md
!src/dnadesign/baserender/workspaces/demo_densegen_render/
!src/dnadesign/baserender/workspaces/demo_densegen_render/.baserender-workspace
!src/dnadesign/baserender/workspaces/demo_densegen_render/job.yaml
!src/dnadesign/baserender/workspaces/demo_densegen_render/inputs/
!src/dnadesign/baserender/workspaces/demo_densegen_render/inputs/input.parquet
!src/dnadesign/baserender/workspaces/demo_densegen_render/outputs/
!src/dnadesign/baserender/workspaces/demo_densegen_render/outputs/.gitkeep
!src/dnadesign/baserender/workspaces/demo_cruncher_render/
!src/dnadesign/baserender/workspaces/demo_cruncher_render/.baserender-workspace
!src/dnadesign/baserender/workspaces/demo_cruncher_render/job.yaml
!src/dnadesign/baserender/workspaces/demo_cruncher_render/inputs/
!src/dnadesign/baserender/workspaces/demo_cruncher_render/inputs/README.md
!src/dnadesign/baserender/workspaces/demo_cruncher_render/inputs/elites_showcase_records.parquet
!src/dnadesign/baserender/workspaces/demo_cruncher_render/inputs/motif_library.json
!src/dnadesign/baserender/workspaces/demo_cruncher_render/outputs/
!src/dnadesign/baserender/workspaces/demo_cruncher_render/outputs/.gitkeep
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/.baserender-workspace
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/README.md
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/job.yaml
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/inputs/
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/inputs/README.md
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/outputs/
!src/dnadesign/baserender/workspaces/usr_promoter_references_genbank/outputs/.gitkeep

# LatentDNA workspaces: keep configs/templates tracked; generated analysis outputs stay local.
# The stress study snapshot is a sanctioned checked-in status record; use
# `latentdna workspace snapshot --dry-run` for read-only inspections.
src/dnadesign/latentdna/workspaces/**/outputs/

**/_densegen_ids.sqlite
**/campaign.log.jsonl
**/round.log.jsonl
**/state.json
**/.opal/
/$OPAL_TMPDIR/

# SeqLedger datasets (large, not for git)
src/dnadesign/seqledger/datasets/**
