# =============================================================================
# dnadesign — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# OS cruft
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux/Unix temp + swap
*.~lock.*
*~
*.swp
*.swo

# -----------------------------------------------------------------------------
# Editor / IDE cruft
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Misc editor output
out/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Python build & tooling
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd

# Packaging / builds
*.egg
*.egg-info/
.eggs/
build/
dist/
*.whl

# Virtual envs
.venv/
env/
venv/
.pixi/

# Test/analysis caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.cache/matplotlib/
.nox/
.coverage
.coverage.*
htmlcov/

# -----------------------------------------------------------------------------
# Node / JS (if present)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Logs, temp files
# -----------------------------------------------------------------------------
*.log
*.out
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
temp.md
tmp/

# Local operator configuration (copy the tracked example before use)
src/dnadesign/usr/remotes.yaml

# -----------------------------------------------------------------------------
# Archives
# -----------------------------------------------------------------------------
/archived/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -----------------------------------------------------------------------------
# Large/binary data artifacts (keep out of git)
# -----------------------------------------------------------------------------
*.parquet
!src/dnadesign/latentdna/workspaces/rt_lnrna_sponging_construct_triage/study_inputs/reader_spop_candidate_summary.parquet
!src/dnadesign/latentdna/workspaces/rt_lnrna_sponging_construct_triage/study_inputs/reader_spop_observations.parquet
*.parq
*.pq
*.feather
*.joblib
*.pkl
*.pt
!src/dnadesign/baserender/docs/examples/data/*.parquet

# -----------------------------------------------------------------------------
# Images: ignore by default; allow curated exceptions
# -----------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.gif

# allow curated PNGs
!src/dnadesign/nmf/images/
!src/dnadesign/nmf/images/*.png
!src/dnadesign/libshuffle/images/*.png
!images/*.png
# allow Cruncher docs media
!src/dnadesign/cruncher/docs/**/*.png
!src/dnadesign/cruncher/docs/**/*.jpg
!src/dnadesign/cruncher/docs/**/*.jpeg
!src/dnadesign/cruncher/docs/**/*.gif
!src/dnadesign/cruncher/images/*.png

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
